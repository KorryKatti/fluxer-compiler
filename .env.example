# Copy to .env and fill in:  cp .env.example .env

# Raw Fluxer bot token (no "Bot " / "Bearer " prefix)
FLUXER_BOT_TOKEN=

# Instance origin — leave default for fluxer.app, set for self-hosted
FLUXER_ORIGIN=https://fluxer.app

# Command prefix
COMMAND_PREFIX=!

# Custom status shown on ready
CUSTOM_STATUS_TEXT=compiling code...
CUSTOM_STATUS_EMOJI=💻

# Cooldown between run/compile per user, in ms (default 60000 = 1 minute).
COOLDOWN_MS=60000

# Where cooldowns.json lives (default: ./data, /app/data in Docker)
DATA_DIR=data

# Max simultaneous Godbolt requests; extra run/compile calls queue (FIFO)
MAX_IN_FLIGHT=5

# Global cap across all users, requests/minute sustained (default 30).
# Above this the bot replies "Server busy" instead of queueing forever.
GLOBAL_RATE_PER_MIN=30
